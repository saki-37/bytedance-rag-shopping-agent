# Copy to .env and fill local secrets. Do not commit real values.

ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/
ARK_MODEL=

# Default is ark for development/regression. Use yunwu only for faster demos.
LLM_PROVIDER=ark
YUNWU_API_KEY=
YUNWU_BASE_URL=https://yunwu.ai/v1
YUNWU_MODEL=gpt-5.4-mini

PLANNER_TIMEOUT_SECONDS=20
FAST_FIRST_SCREEN_ENABLED=true
FAST_QUICK_REPLY_DEADLINE_SECONDS=0.8

APP_ENV=local
MOCK_LLM=false
