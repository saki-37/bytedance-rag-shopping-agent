[
  {
    "id": "CQ-01",
    "title": "复杂约束下仍能保留已知条件并返回可证据支撑的部分匹配",
    "turns": [
      {
        "user": "我是油皮，想要200元以内通勤防晒。敏感肌最近屏障不稳定，想找修护面霜。不要酒精味太重或者刺激感强的产品。我想买护肤品，你推荐什么？",
        "expect": {
          "must_clarify": false,
          "min_products": 1,
          "expected_budget_max": 200,
          "expected_facets": {
            "skin_type": ["油皮", "敏感肌"],
            "effect": ["防晒", "修护"],
            "use_case": ["通勤"]
          },
          "expected_exclude_terms": ["酒精", "刺激"],
          "expected_any_product_ids": ["p_beauty_006"],
          "max_product_price": 200
        }
      }
    ]
  },
  {
    "id": "CQ-02",
    "title": "用户放宽预算时继承上一轮需求并取消预算硬约束",
    "turns": [
      {
        "user": "我是油皮，想要200元以内通勤防晒。敏感肌最近屏障不稳定，想找修护面霜。不要酒精味太重或者刺激感强的产品。我想买护肤品，你推荐什么？"
      },
      {
        "user": "先放宽预算",
        "expect": {
          "must_clarify": false,
          "min_products": 1,
          "expected_budget_max": null,
          "expected_exclude_terms": ["酒精", "刺激"],
          "expected_any_product_ids": ["p_beauty_006", "p_beauty_012"],
          "state_merge_applied": true,
          "expected_state_actions_contains": ["relax_budget"],
          "retrieval_message_contains": ["规则合并后的检索状态", "预算：不限制", "本轮补充", "先放宽预算"]
        }
      }
    ]
  },
  {
    "id": "CQ-03",
    "title": "用户降低预算时使用最新预算覆盖上一轮预算",
    "turns": [
      {
        "user": "我是油皮，想要200元以内通勤防晒。敏感肌最近屏障不稳定，想找修护面霜。不要酒精味太重或者刺激感强的产品。我想买护肤品，你推荐什么？"
      },
      {
        "user": "我想把预算降到150元",
        "expect": {
          "must_clarify": true,
          "max_products": 0,
          "expected_budget_max": 150,
          "expected_exclude_terms": ["酒精", "刺激"],
          "clarification_contains": ["150元以内", "没有同时满足"],
          "forbidden_product_ids": ["p_beauty_006"]
        }
      }
    ]
  },
  {
    "id": "CQ-04",
    "title": "泛泛想买护肤品时先追问而不是乱推商品",
    "turns": [
      {
        "user": "我想买护肤品，你推荐什么？",
        "expect": {
          "must_clarify": true,
          "max_products": 0,
          "clarification_contains": ["肤质", "预算", "功效"]
        }
      }
    ]
  },
  {
    "id": "CQ-05",
    "title": "5轮预算更新、取消预算和排除条件继承",
    "turns": [
      {
        "user": "我是油皮，想要200元以内通勤防晒，不要酒精味太重或者刺激感强的产品。",
        "expect": {
          "must_clarify": false,
          "min_products": 1,
          "expected_budget_max": 200,
          "expected_facets": {
            "skin_type": ["油皮"],
            "effect": ["防晒"],
            "use_case": ["通勤"]
          },
          "expected_exclude_terms": ["酒精", "刺激"],
          "max_product_price": 200
        }
      },
      {
        "user": "预算可以放宽到300",
        "expect": {
          "must_clarify": false,
          "min_products": 1,
          "expected_budget_max": 300,
          "expected_exclude_terms": ["酒精", "刺激"],
          "state_merge_applied": true,
          "expected_state_actions_contains": ["set_budget=300"],
          "retrieval_message_contains": ["规则合并后的检索状态", "300元以内", "不要酒精、刺激"]
        }
      },
      {
        "user": "有没有更便宜一点的",
        "expect": {
          "must_clarify": false,
          "min_products": 1,
          "expected_budget_max": 300,
          "expected_exclude_terms": ["酒精", "刺激"],
          "expected_facets": {
            "skin_type": ["油皮"],
            "effect": ["防晒"],
            "use_case": ["通勤"]
          },
          "state_merge_applied": true
        }
      },
      {
        "user": "我想把预算降到150元",
        "expect": {
          "must_clarify": true,
          "max_products": 0,
          "expected_budget_max": 150,
          "expected_exclude_terms": ["酒精", "刺激"],
          "state_merge_applied": true,
          "expected_state_actions_contains": ["set_budget=150"]
        }
      },
      {
        "user": "先不看预算，但酒精刺激还是不要",
        "expect": {
          "must_clarify": false,
          "min_products": 1,
          "expected_budget_max": null,
          "expected_exclude_terms": ["酒精", "刺激"],
          "state_merge_applied": true,
          "expected_state_actions_contains": ["relax_budget"]
        }
      }
    ]
  }
]
