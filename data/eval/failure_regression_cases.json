  {
    "id": "FR-005",
    "title": "类目切换：明确非化妆品运动类时不能继续推荐美妆",
    "source": "Android 真实测试：给妈妈买礼物时追问非化妆品运动类仍推荐化妆品",
    "history": [
      {
        "role": "user",
        "content": "我想给我妈买生日礼物，你有什么推荐吗？"
      },
      {
        "role": "assistant",
        "content": "先给了几款美妆候选。",
        "product_ids": ["p_beauty_018", "p_beauty_010", "p_beauty_014"]
      },
      {
        "role": "user",
        "content": "有没有什么运动类的推荐？"
      },
      {
        "role": "assistant",
        "content": "曾经错误地给了运动相关美妆候选。",
        "product_ids": ["p_beauty_020", "p_beauty_010"]
      }
    ],
    "turns": [
      {
        "user": "有没有什么运动类的非化妆品推荐？",
        "expect": {
          "expected_category_candidates": ["apparel"],
          "forbidden_category_candidates": ["beauty"],
          "allowed_product_categories": ["服饰运动"],
          "forbidden_product_categories": ["美妆护肤"],
          "min_products": 1,
          "retrieval_message_contains": ["类目：服饰运动"],
          "retrieval_message_not_contains": ["类目：美妆护肤", "肤质："]
        }
      }
    ]
  },
  {
    "id": "FR-006",
    "title": "口语预算收窄：150 元以内无满足防晒时不能继续推荐 170/268/298",
    "source": "Android 真实测试：夏季防晒多轮收窄预算仍返回超预算商品",
    "history": [
      {
        "role": "user",
        "content": "夏天快到了，想看看防晒!"
      },
      {
        "role": "assistant",
        "content": "给你推荐了几款夏季防晒。",
        "product_ids": ["p_beauty_010", "p_beauty_023", "p_beauty_006"]
      },
      {
        "role": "user",
        "content": "我是油皮，主要是户外需求"
      },
      {
        "role": "assistant",
        "content": "结合油皮和户外需求，仍优先看防晒候选。",
        "product_ids": ["p_beauty_010", "p_beauty_023", "p_beauty_006"]
      }
    ],
    "turns": [
      {
        "user": "我的预算可能只有150",
        "expect": {
          "must_clarify": true,
          "max_products": 0,
          "expected_budget_max": 150,
          "expected_facets": {
            "skin_type": ["油皮"],
            "effect": ["防晒"],
            "use_case": ["户外"]
          },
          "forbidden_product_ids": ["p_beauty_010", "p_beauty_023", "p_beauty_006"],
          "clarification_contains": ["150元以内", "没有同时满足"],
          "retrieval_message_contains": ["150元以内"]
        }
      }
    ]
  },
